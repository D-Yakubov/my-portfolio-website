---
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import { SITE, NAV_LINKS } from "@consts";
---

<header>
  <Container>
    <div class="flex flex-wrap gap-y-2 justify-between items-center">
      <Link href="/" underline={false}>
        <div class="font-semibold font-mono tracking-tight text-black dark:text-white flex items-center gap-1.5 group">
          <span class="text-emerald-500 font-bold group-hover:translate-x-0.5 transition-transform">&gt;_</span>
          <span>{SITE.NAME}</span>
        </div>
      </Link>
      <nav class="flex items-center gap-2 text-xs sm:text-sm font-mono">
        {NAV_LINKS.map((link, index) => (
          <div class="flex items-center gap-2">
            <Link href={link.HREF}>
              {link.NAME.toLowerCase()}
            </Link>
            {index < NAV_LINKS.length - 1 && (
              <span class="opacity-30">/</span>
            )}
          </div>
        ))}
      </nav>
    </div>
  </Container>
</header>
