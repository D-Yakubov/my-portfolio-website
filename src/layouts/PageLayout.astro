---
import Head from "@components/Head.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import { SITE } from "@consts";
import type { SupportedLang, FAQItem } from "@i18n/ui";

type Props = {
  title: string;
  description: string;
  lang?: SupportedLang;
  faq?: FAQItem[];
};

const { title, description, lang = "en", faq } = Astro.props;
const pageTitle = title === SITE.TITLE || title.includes("Dastonbek") ? title : `${title} | ${SITE.NAME}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <Head title={pageTitle} description={description} lang={lang} faq={faq} />
  </head>
  <body>
    <Header lang={lang} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
