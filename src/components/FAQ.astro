---
import { getTranslations, type SupportedLang } from "@i18n/ui";

type Props = {
  lang?: SupportedLang;
};

const { lang = "en" } = Astro.props;
const t = getTranslations(lang);
const faq = t.faq;
---

<section id="faq" class="animate space-y-6 scroll-mt-24">
  <div class="flex items-center justify-between border-b border-neutral-300 dark:border-neutral-800 pb-3">
    <div class="flex items-center gap-2">
      <span class="text-xs font-mono text-emerald-600 dark:text-emerald-400">{t.faqSection.badge}</span>
      <h2 class="text-xs font-mono font-semibold uppercase tracking-wider text-black dark:text-white">
        {t.faqSection.title}
      </h2>
    </div>
    <span class="text-xs font-mono opacity-50 hidden sm:inline">{t.faqSection.subtitle}</span>
  </div>

  <div class="space-y-3">
    {faq.map((item, index) => {
      const qNum = String(index + 1).padStart(2, "0");
      return (
        <details class="group rounded-lg border border-neutral-300 dark:border-neutral-800 bg-neutral-50/50 dark:bg-neutral-900/40 p-4 transition-all duration-200 open:border-neutral-400 dark:open:border-neutral-700">
          <summary class="flex cursor-pointer items-center justify-between gap-3 text-left font-semibold text-sm sm:text-base text-black dark:text-white list-none select-none">
            <div class="flex items-start gap-2.5">
              <span class="font-mono text-xs text-emerald-600 dark:text-emerald-400 shrink-0 mt-0.5">
                [{qNum}]
              </span>
              <span>{item.question}</span>
            </div>
            <span class="shrink-0 font-mono text-xs text-neutral-400 transition-transform duration-200 group-open:rotate-45">
              +
            </span>
          </summary>
          <div class="mt-3 pl-7 pr-2 text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 font-sans leading-relaxed border-t border-neutral-200 dark:border-neutral-800/60 pt-3">
            {item.answer}
          </div>
        </details>
      );
    })}
  </div>
</section>
