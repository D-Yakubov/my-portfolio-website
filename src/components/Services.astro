---
import { getTranslations, type SupportedLang } from "@i18n/ui";

type Props = {
  lang?: SupportedLang;
};

const { lang = "en" } = Astro.props;
const t = getTranslations(lang);
const services = t.services;
---

<section id="services" class="animate space-y-6 scroll-mt-24">
  <div class="flex items-center justify-between border-b border-neutral-300 dark:border-neutral-800 pb-3">
    <div class="flex items-center gap-2">
      <span class="text-xs font-mono text-emerald-600 dark:text-emerald-400">{t.servicesSection.badge}</span>
      <h2 class="text-xs font-mono font-semibold uppercase tracking-wider text-black dark:text-white">
        {t.servicesSection.title}
      </h2>
    </div>
    <span class="text-xs font-mono opacity-50 hidden sm:inline">{t.servicesSection.subtitle}</span>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    {services.map((service) => (
      <div class="group relative rounded-lg border border-neutral-300 dark:border-neutral-800 bg-neutral-50/50 dark:bg-neutral-900/40 p-5 flex flex-col justify-between hover:border-neutral-400 dark:hover:border-neutral-700 transition-all duration-200">
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <div class="p-2 rounded bg-neutral-200/70 dark:bg-neutral-800 text-neutral-900 dark:text-emerald-400">
              {service.icon === "database" && (
                <svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <ellipse cx="12" cy="5" rx="9" ry="3"/>
                  <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/>
                  <path d="M3 12c0 1.66 4 3 9 3s9-1.34 9-3"/>
                </svg>
              )}
              {service.icon === "brain" && (
                <svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 2a4 4 0 0 0-4 4v1a4 4 0 0 0-2 3.5 4 4 0 0 0 2 3.5V15a4 4 0 0 0 4 4h0a4 4 0 0 0 4-4v-1a4 4 0 0 0 2-3.5 4 4 0 0 0-2-3.5V6a4 4 0 0 0-4-4Z"/>
                  <path d="M9 10h6"/>
                  <path d="M12 7v6"/>
                </svg>
              )}
              {service.icon === "api" && (
                <svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="18" height="18" x="3" y="3" rx="2"/>
                  <path d="m9 8 3 3-3 3"/>
                  <path d="M14 14h2"/>
                </svg>
              )}
              {service.icon === "bot" && (
                <svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="18" height="14" x="3" y="6" rx="2"/>
                  <path d="M12 2v4"/>
                  <circle cx="8" cy="12" r="1" fill="currentColor"/>
                  <circle cx="16" cy="12" r="1" fill="currentColor"/>
                  <path d="M9 16h6"/>
                </svg>
              )}
              {service.icon === "zap" && (
                <svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
                </svg>
              )}
              {service.icon === "chart" && (
                <svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 3v18h18"/>
                  <path d="m19 9-5 5-4-4-3 3"/>
                </svg>
              )}
            </div>
            <span class="font-mono text-xs opacity-40">[{service.code}]</span>
          </div>

          <div>
            <h3 class="font-semibold text-sm sm:text-base text-black dark:text-white">
              {service.title}
            </h3>
            <p class="text-xs font-mono text-emerald-600 dark:text-emerald-400 mt-0.5">
              {service.tagline}
            </p>
            <p class="text-xs text-neutral-600 dark:text-neutral-400 mt-1 leading-relaxed">
              {service.summary}
            </p>
          </div>
        </div>

        <ul class="mt-4 pt-3 border-t border-neutral-200 dark:border-neutral-800/80 space-y-1.5 text-[11px] font-mono opacity-80">
          {service.details.map((detail) => (
            <li class="flex items-start gap-1.5">
              <span class="text-emerald-500 font-bold shrink-0">&rsaquo;</span>
              <span>{detail}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
